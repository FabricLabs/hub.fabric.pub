# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.test
.env.local-mainnet

# Local Hub UI test secrets (mnemonic / xprv / admin token — never commit)
local/hub-ui-test-secrets.json

# Local Fabric operator identity (mnemonic + keys — never commit)
local/fabric-operator-identity.json
local/cursor-agent-fabric-identity.json

# Hub browser bootstrap with dev seed (generated from operator-identity emit-hub-config)
assets/config.local.js

# parcel-bundler cache (https://parceljs.org/)
.cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and *not* Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Fabric Schema Store
stores/schemata

# Test store (isolated from main hub; do not commit)
stores/hub-test

# Hub operator debug mirror (see functions/hubDebugFileLog.js)
stores/hub/debug.log
logs/hub/debug.log
logs/hub/debug.log.1

# Screenshot capture ephemeral Hub datadirs
stores/screenshot-runs/

# Local playnet regtest mesh (launcher-generated state)
stores/playnet-mesh-runtime/

# MacOS garbage
.DS_Store

# Store
store/

# Managed bitcoind / lightningd (keep binaries/README.md)
binaries/**
!binaries/README.md
build/.installer-binaries/**
!build/.installer-binaries/.keep

# Public /downloads installers (keep README + .gitkeep; index.json is generated)
assets/downloads/**
!assets/downloads/README.md
!assets/downloads/.gitkeep

# Browser extension build artifacts (@fabric/hub)
extension/vendor/
extension/popup.bundle.js

# Local scratch / PR dumps (dominate npm pack if left unignored)
.tmp-*
.tmp-pr*/
192.168.50.5
test-my-assumptions.js
.archive/

# Accidental LevelDB in assets/
/assets/CURRENT
/assets/LOCK
/assets/LOG
/assets/LOG.old
/assets/MANIFEST-*

# Managed Bitcoin / Lightning datadirs (blk00000.dat is ~16 MiB)
stores/bitcoin-*/
stores/lightning/

# Leftover schema / lightning test copies
stores/schemas/
stores/schemas-backup/
stores/hub-test-lightning/
stores/hub-test-lightning-nc/

# Local Fomantic checkout — compiled CSS/JS already lives in assets/
libraries/fomantic/
