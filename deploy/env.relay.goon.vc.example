# Fabric Hub on the dedicated relay.goon.vc address (same host as hub.fabric.pub).
# DNS: relay.goon.vc → 65.21.231.149
# Copy to the process environment (or systemd EnvironmentFile). Do not commit secrets.

# --- Identity (REQUIRED in production; back up offline) ---
# Prefer FABRIC_XPRV so every Fabric suite process (Hub, applications, …)
# resolves the same operator key. FABRIC_SEED / FABRIC_MNEMONIC also work.
# FABRIC_XPRV=
# FABRIC_SEED=
# FABRIC_MNEMONIC=

# --- Fabric Peer (TCP/NOISE :7777) — bind the dedicated public NIC ---
FABRIC_PORT=7777
FABRIC_INTERFACE=65.21.231.149
# Advertise / self-dial filter (hostname, not the raw IP):
FABRIC_PUBLIC_HOST=relay.goon.vc

# --- HTTP / WebSocket ---
# Preferred: Caddy (or similar) terminates TLS for https://relay.goon.vc and
# proxies to loopback. Bind HTTP only on localhost in that case:
FABRIC_HUB_HOSTNAME=relay.goon.vc
FABRIC_HUB_PORT=8080
FABRIC_HUB_INTERFACE=127.0.0.1
#
# Bare public HTTP (no reverse proxy) — bind the same NIC instead:
# FABRIC_HUB_INTERFACE=65.21.231.149

# --- Peers ---
# On the relay host, omit relay.goon.vc:7777 from settings.peers (avoid self-dial).
# Leave hub.fabric.pub:7777 (and other seeds) as needed.

NODE_ENV=production
