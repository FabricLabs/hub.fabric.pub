{
  "name": "@fabric/hub",
  "version": "0.1.0-RC1",
  "description": "Peer rendezvous for Fabric.",
  "desktopName": "pub.fabric.hub",
  "main": "services/hub.js",
  "exports": {
    ".": "./services/hub.js",
    "./components/ActivityStream": "./components/ActivityStream.js",
    "./components/Bridge": "./components/Bridge.js",
    "./components/HubInterface": "./components/HubInterface.js",
    "./components/DelegationSigningModal": "./components/DelegationSigningModal.js",
    "./components/SettingsHome": "./components/SettingsHome.js",
    "./functions/fabricMessageEnvelope": "./functions/fabricMessageEnvelope.js",
    "./functions/fabricDocumentOfferEnvelope": "./functions/fabricDocumentOfferEnvelope.js",
    "./functions/documentInventoryMarket": "./functions/documentInventoryMarket.js",
    "./functions/identityCluster": "./functions/identityCluster.js",
    "./functions/identityClusterHttp": "./functions/identityClusterHttp.js",
    "./functions/identityCrossSign": "./functions/identityCrossSign.js",
    "./functions/identityCrossSignVerify": "./functions/identityCrossSignVerify.js",
    "./functions/fabricLinkedDevices": "./functions/fabricLinkedDevices.js",
    "./functions/fabricProtocolUrl": "./functions/fabricProtocolUrl.js",
    "./functions/fabricDesktopAuth": "./functions/fabricDesktopAuth.js",
    "./functions/fabricDesktopLoginVerify": "./functions/fabricDesktopLoginVerify.js",
    "./functions/fabricDeviceLink": "./functions/fabricDeviceLink.js",
    "./functions/fabricDeviceLinkClient": "./functions/fabricDeviceLinkClient.js",
    "./functions/fabricDeviceLinkMessages": "./functions/fabricDeviceLinkMessages.js",
    "./functions/fabricDelegation": "./functions/fabricDelegation.js",
    "./functions/fabricDelegationLocal": "./functions/fabricDelegationLocal.js",
    "./functions/fabricHubAllowlist": "./functions/fabricHubAllowlist.js",
    "./functions/httpSharedMode": "./functions/httpSharedMode.js",
    "./functions/oracleAttestation": "./functions/oracleAttestation.js",
    "./functions/fabricPubkey": "./functions/fabricPubkey.js",
    "./functions/fabricChatNormalize": "./functions/fabricChatNormalize.js",
    "./functions/bulkSecurityAdvisory": "./functions/bulkSecurityAdvisory.js",
    "./functions/operatorAdminToken": "./functions/operatorAdminToken.js",
    "./functions/hubLifecycle": "./functions/hubLifecycle.js",
    "./functions/sidechainState": "./functions/sidechainState.js",
    "./functions/peerIdentity": "./functions/peerIdentity.js",
    "./functions/contractMessageQueue": "./functions/contractMessageQueue.js",
    "./services/fabric": "./services/fabric.js",
    "./services/email": "./services/email.js",
    "./components/SecuritySessionHome": "./components/SecuritySessionHome.js",
    "./types/LightningChannel": "./types/lightningChannel.js"
  },
  "engines": {
    "node": "24.15.0",
    "npm": ">=12.0.0"
  },
  "files": [
    "components/**/*.js",
    "contracts/**",
    "functions/**/*.js",
    "libs/**/*.js",
    "routes/**/*.js",
    "scripts/**/*.js",
    "scripts/startup/**",
    "services/**/*.js",
    "settings/*.json",
    "shims/**",
    "types/**/*.js",
    "constants.js",
    "assets/**",
    "!assets/downloads/**",
    "!assets/CURRENT",
    "!assets/LOCK",
    "!assets/LOG",
    "!assets/LOG.old",
    "!assets/MANIFEST-*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "AGENTS.md",
    "docs/**/*.md"
  ],
  "scripts": {
    "build": "npm run build:browser",
    "build:browser": "node scripts/build.js",
    "build:desktop": "npm run build:browser && electron-builder build && node scripts/sync-downloads-assets.js",
    "build:desktop:dir": "npm run build:browser && electron-builder --dir",
    "binaries:fetch": "node scripts/download-managed-binaries.js",
    "binaries:fetch:all": "node scripts/download-managed-binaries.js --all",
    "build:installers": "npm run build:browser && node scripts/download-managed-binaries.js --all && node scripts/build-installers.js",
    "link:fabric": "bash scripts/link-fabric.sh",
    "predesktop": "node scripts/ensure-fabric-linked.js && node scripts/prepare-hub-dev-port.js",
    "desktop": "npm run build:browser && env -u ELECTRON_RUN_AS_NODE ./node_modules/.bin/electron scripts/desktop.js",
    "desktop:debug": "npm run build:browser && env -u ELECTRON_RUN_AS_NODE ./node_modules/.bin/electron --inspect=9229 scripts/desktop.js",
    "build:extension": "node scripts/build-extension.js",
    "ci": "npm run build && npm run test:unit",
    "coverage": "c8 npm test",
    "build:semantic": "node scripts/build-semantic-assets.js",
    "make:fonts": "npm run make:fonts --prefix ./node_modules/@fabric/http",
    "dev": "webpack serve --mode development --open",
    "make:api": "jsdoc2md --configure jsdoc.json --files services/hub.js README.md > API.md",
    "make:app": "node scripts/build.js",
    "make:browser": "npm run build:browser",
    "make:coverage": "npm run coverage && c8 report --reporter html",
    "reports": "npm run report:install && npm run report:coverage",
    "report:coverage": "npm run make:coverage && c8 report --reporter=text-lcov > reports/coverage.lcov",
    "report:install": "rm -rf node_modules && mkdir -p reports && rm -f package-lock.json && echo \"$ npm i --allow-git=all\" > reports/install.log && npm i --allow-git=all >> reports/install.log 2>&1",
    "report:legal": "node_modules/.bin/license-checker --json > reports/licenses.json",
    "report:dependency-trees": "node scripts/generate-dependency-trees.js",
    "report:todo": "grep --exclude package.json --exclude-dir=.env --exclude-dir=.git --exclude-dir=_book --exclude-dir=stores --exclude-dir=assets --exclude-dir=node_modules --exclude-dir=reports --exclude-dir=coverage --exclude-dir=docs --exclude-dir=libraries -rEI \"TODO|FIXME\" . | sed 's/\\([^:]*:\\)[ ]*/\\1 /' > reports/TODO.txt",
    "review:coverage": "npm run make:coverage && http-server -p 8000 reports/coverage",
    "prestart": "node scripts/prepare-hub-dev-port.js",
    "start": "npm run build && node scripts/hub.js",
    "start:fast": "node scripts/prepare-hub-dev-port.js && node scripts/hub.js",
    "reset:stores": "node scripts/reset-hub-stores.js",
    "hub-ui:test-secrets": "node scripts/hub-ui-write-test-secrets.js",
    "hub-ui:test-secrets:inject": "node scripts/hub-ui-write-test-secrets.js --print-inject",
    "operator-identity:init": "node scripts/fabric-operator-identity.js init",
    "operator-identity:emit-hub-config": "node scripts/fabric-operator-identity.js emit-hub-config",
    "operator-identity:print-env": "node scripts/fabric-operator-identity.js print-shell-export",
    "operator-identity:sync": "node scripts/fabric-operator-identity-sync.js",
    "start:mainnet-local": "bash scripts/run-hub-local-mainnet.sh",
    "sync": "npm run sync:specs",
    "sync:specs": "scripts/import-specs.sh",
    "test": "NODE_ENV=test NODE_PATH=\"$PWD/node_modules${NODE_PATH:+:$NODE_PATH}\" mocha tests --exit --ignore tests/browser.hubAlerts.test.js --ignore tests/browser.onboardingPeers.e2e.test.js",
    "test:unit": "NODE_ENV=test NODE_PATH=\"$PWD/node_modules${NODE_PATH:+:$NODE_PATH}\" mocha tests --exit --ignore tests/browser.interface.test.js --ignore tests/browser.hubAlerts.test.js --ignore tests/browser.onboardingPeers.e2e.test.js --ignore tests/crowdfunding.regtest.integration.js --ignore tests/hub.inventory.htlc.e2e.test.js --ignore tests/hub.payjoin.l1.e2e.test.js --ignore tests/hub.core-features.l1.e2e.test.js",
    "test:bridge": "mocha tests/bridge.webrtc.signal.test.js",
    "puppeteer:install-chrome": "node node_modules/@fabric/http/node_modules/puppeteer/install.mjs || node ../fabric-http/node_modules/puppeteer/install.mjs || npx --package=puppeteer@24.37.5 puppeteer browsers install chrome",
    "screenshots": "NODE_PATH=\"$PWD/node_modules/@fabric/http/node_modules${NODE_PATH:+:$NODE_PATH}\" node scripts/capture-user-flows.js",
    "screenshots:l1": "HUB_SCREENSHOTS_L1=1 NODE_PATH=\"$PWD/node_modules/@fabric/http/node_modules${NODE_PATH:+:$NODE_PATH}\" node scripts/capture-user-flows.js",
    "test:browser": "npm run build:browser && mocha tests/browser.interface.test.js --exit --timeout 60000",
    "test:e2e-browser": "npm run build:browser && HUB_E2E=1 mocha tests/browser.interface.test.js --exit --timeout 90000",
    "test:e2e-browser-onboarding": "npm run build:browser && HUB_E2E_UI_ONBOARDING=1 mocha tests/browser.onboardingPeers.e2e.test.js --exit --timeout 120000",
    "test:e2e-hub-alerts": "mocha tests/browser.hubAlerts.test.js --exit --timeout 120000",
    "test:e2e-payjoin": "node scripts/verify-payjoin-e2e.js",
    "test:e2e-payjoin-l1": "FABRIC_PAYJOIN_L1_E2E=1 mocha tests/hub.payjoin.l1.e2e.test.js --exit --timeout 240000",
    "test:e2e-all-browser": "node scripts/verify-browser-e2e-suite.js",
    "test:stack": "node scripts/verify-full-stack.js",
    "test:stack:no-l1": "FABRIC_STACK_SKIP_L1_CONTRACTS=1 node scripts/verify-full-stack.js",
    "ci:e2e-payjoin": "bash scripts/ci-e2e-payjoin.sh",
    "test:crowdfund-regtest": "FABRIC_CROWDFUND_REGTEST=1 mocha tests/crowdfunding.regtest.integration.js --exit --timeout 600000",
    "test:e2e-storage-contract": "node scripts/verify-storage-contract-e2e.js",
    "test:e2e-document-purchase": "node scripts/verify-document-purchase-e2e.js",
    "test:e2e-inventory-htlc": "FABRIC_INVENTORY_HTLC_E2E=1 mocha tests/hub.inventory.htlc.e2e.test.js --exit --timeout 240000",
    "test:e2e-core-features-l1": "FABRIC_CORE_FEATURES_L1_E2E=1 mocha tests/hub.core-features.l1.e2e.test.js --exit --timeout 480000",
    "test:e2e-execution-contract": "node scripts/verify-execution-contract-e2e.js",
    "test:e2e-execution-anchor": "FABRIC_EXEC_E2E_ANCHOR=1 node scripts/verify-execution-contract-e2e.js",
    "test:e2e-crowdfund-l1": "node scripts/verify-crowdfund-l1-e2e.js",
    "test:e2e-value-flows": "node scripts/verify-value-flows-e2e.js",
    "test:e2e-contracts-l1": "node scripts/verify-contracts-l1-e2e-suite.js",
    "test:lightning": "NODE_ENV=test mocha tests/lightning.hub.http.test.js tests/lightning.bitcoinClient.test.js --exit",
    "test:smoke-mainnet-rpc": "node scripts/verify-mainnet-rpc-smoke.js",
    "bitcoin:addnode": "node scripts/bitcoin-addnode.js",
    "test:playnet-mesh": "FABRIC_PLAYNET_MESH=1 mocha tests/playnet.market.integration.js --exit --timeout 600000",
    "test:playnet-mesh-l1": "FABRIC_BITCOIN_SKIP_PLAYNET_PEER=1 FABRIC_PLAYNET_MESH_L1=1 mocha tests/playnet.market.integration.js --exit --timeout 600000",
    "test:playnet-mesh-l1-chain-deep": "FABRIC_BITCOIN_SKIP_PLAYNET_PEER=1 FABRIC_PLAYNET_MESH_L1=1 FABRIC_PLAYNET_BROWSER_DEEP_TX=1 FABRIC_PLAYNET_BROWSER_DEEP_BLOCK=1 mocha tests/playnet.market.integration.js --exit --timeout 600000",
    "test:playnet-mesh-l1-browser-deep": "npm run test:playnet-mesh-l1-chain-deep",
    "test:playnet-mesh-l1-desktop-star": "FABRIC_BITCOIN_SKIP_PLAYNET_PEER=1 FABRIC_PLAYNET_MESH_L1=1 FABRIC_PLAYNET_DESKTOP_STAR=1 FABRIC_PLAYNET_BROWSER_DEEP_TX=1 FABRIC_PLAYNET_BROWSER_DEEP_BLOCK=1 mocha tests/playnet.market.integration.js --exit --timeout 600000",
    "test:playnet-beacon": "FABRIC_BITCOIN_SKIP_PLAYNET_PEER=1 FABRIC_PLAYNET_BEACON=1 mocha tests/playnet.beacon.federation.integration.js --exit --timeout 400000",
    "test:playnet-publish-scan": "mocha tests/playnet.contract.publish.scan.integration.js --exit --timeout 120000",
    "test:playnet-publish-scan-live": "FABRIC_BITCOIN_SKIP_PLAYNET_PEER=1 FABRIC_PLAYNET_PUBLISH_SCAN=1 mocha tests/playnet.contract.publish.scan.integration.js --exit --timeout 400000",
    "playnet:mesh": "node scripts/playnet-regtest-mesh-launch.js",
    "playnet:mesh:open": "node scripts/playnet-regtest-mesh-launch.js --open",
    "playnet:flush": "node scripts/playnet-flush-chain.js",
    "playnet:reset": "node scripts/playnet-reset.js",
    "playnet:status": "node scripts/playnet-status.js",
    "playnet:l1-resolve": "node scripts/playnet-l1-resolve.js",
    "playnet:mine-subsidy": "node scripts/playnet-mine-subsidy.js",
    "test:e2e-http-routes": "node scripts/verify-http-routes.js",
    "test:e2e-webrtc": "node scripts/verify-webrtc-chat-e2e.js",
    "test:hub-webrtc": "mocha tests/hub.webrtc.rpc.test.js",
    "test:document-network": "mocha tests/hub.document.network.e2e.test.js --exit --timeout 180000",
    "test:fabric-epic": "mocha tests/hub.fabric.epic.e2e.test.js --exit --timeout 240000",
    "test:webrtc": "npm run test:bridge && npm run test:hub-webrtc",
    "todo": "npm run report:todo && cat reports/TODO.txt"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabricLabs/hub.fabric.pub.git"
  },
  "keywords": [
    "fabric",
    "p2p",
    "bitcoin",
    "blockchain",
    "sidechain"
  ],
  "author": "Fabric Labs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FabricLabs/hub.fabric.pub/issues"
  },
  "homepage": "https://github.com/FabricLabs/hub.fabric.pub#readme",
  "dependencies": {
    "@babel/preset-env": "=7.26.7",
    "@babel/preset-react": "=7.26.3",
    "@babel/register": "=7.25.9",
    "@fabric/core": "github:FabricLabs/fabric#feature/rsi",
    "@fabric/http": "github:FabricLabs/fabric-http#feature/rsi",
    "@noble/curves": "=2.0.1",
    "@noble/hashes": "=2.0.1",
    "@types/react": "=18.3.18",
    "bip32": "=4.0.0",
    "bitcoinjs-lib": "=6.1.7",
    "bs58check": "=3.0.1",
    "cross-fetch": "=4.1.0",
    "fast-json-patch": "=3.1.1",
    "graphviz-wasm": "=3.0.2",
    "html5-qrcode": "=2.3.8",
    "isomorphic-ws": "=4.0.1",
    "jquery": "=3.7.1",
    "jsdoc-to-markdown": "=9.1.3",
    "jsdom": "=28.1.0",
    "lodash.merge": "=4.6.2",
    "mocha": "=10.8.2",
    "nodemailer": "=9.0.4",
    "path-browserify": "=1.0.1",
    "process": "=0.11.10",
    "qrcode": "=1.5.4",
    "react": "=18.2.0",
    "react-dom": "=18.2.0",
    "react-redux": "=8.1.0",
    "react-router-dom": "=7.18.2",
    "react-simple-star-rating": "=5.1.7",
    "react-textarea-autosize": "=8.5.7",
    "react-toastify": "=10.0.5",
    "redux": "=4.2.1",
    "redux-thunk": "=2.4.2",
    "semantic-ui-react": "=2.1.5",
    "stoppable": "=1.1.0",
    "stream-browserify": "=3.0.0",
    "tiny-secp256k1": "=2.2.4",
    "webpack": "=5.109.2",
    "ws": "=8.21.2"
  },
  "devDependencies": {
    "babel-loader": "=9.1.3",
    "bip39": "=3.1.0",
    "buffer": "=6.0.3",
    "c8": "=7.11.3",
    "crypto-browserify": "=3.12.1",
    "css-loader": "=6.10.0",
    "ecpair": "=2.1.0",
    "electron": "=39.8.10",
    "electron-builder": "=26.15.7",
    "extend": "=3.0.2",
    "style-loader": "=3.3.4",
    "terser-webpack-plugin": "=5.3.16",
    "vm-browserify": "=1.1.2",
    "webpack-bundle-analyzer": "=4.10.2",
    "webpack-cli": "=5.1.4",
    "webpack-dev-server": "=5.2.6"
  },
  "overrides": {
    "elliptic": "npm:@soatok/elliptic-to-noble@^9999.0.0",
    "serialize-javascript": "7.0.5",
    "ws": "=8.21.2",
    "uuid": "=11.1.1",
    "tar": "=7.5.22",
    "builder-util-runtime": "=9.7.0"
  },
  "c8": {
    "exclude": [
      "assets",
      "tests",
      "stores"
    ],
    "report-dir": "./reports/coverage",
    "temp-dir": "./reports/c8"
  },
  "build": {
    "appId": "pub.fabric.hub",
    "productName": "Fabric Hub",
    "copyright": "Copyright © Fabric Labs",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "beforePack": "./scripts/electron-builder-before-pack.js",
    "extraResources": [
      {
        "from": "build/.installer-binaries",
        "to": "binaries",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "scripts/startup",
        "to": "startup",
        "filter": [
          "**/*"
        ]
      }
    ],
    "npmRebuild": false,
    "compression": "maximum",
    "executableName": "FabricHub",
    "files": [
      "assets/**/*",
      "!assets/downloads/**/*.dmg",
      "!assets/downloads/**/*.pkg",
      "!assets/downloads/**/*.zip",
      "!assets/downloads/**/*.exe",
      "!assets/downloads/**/*.msi",
      "!assets/downloads/**/*.AppImage",
      "!assets/downloads/**/*.deb",
      "!assets/downloads/**/*.rpm",
      "!assets/downloads/**/*.snap",
      "!assets/downloads/**/*.blockmap",
      "scripts/desktop.js",
      "scripts/desktop-preload.js",
      "scripts/desktopHubProbe.js",
      "scripts/hub.js",
      "services/**/*",
      "functions/**/*",
      "libs/**/*",
      "types/**/*",
      "routes/**/*",
      "settings/**/*",
      "contracts/**/*",
      "constants.js",
      "shims/**/*",
      "package.json",
      "!**/.git/**",
      "!**/node_modules/@fabric/http/assets/**",
      "!**/node_modules/@fabric/http/node_modules/**",
      "!**/node_modules/@fabric/http/.git/**",
      "!**/node_modules/@fabric/http/{tests,docs,coverage,stores,examples,reports,libraries,logs}/**",
      "!**/node_modules/@fabric/core/node_modules/**",
      "!**/node_modules/@fabric/core/.git/**",
      "!**/node_modules/@fabric/core/{src,tests,docs,coverage,coverage-*,coverage-hot,coverage-hot2,coverage-hot3,coverage-hot4,coverage-covfocus,stores,examples,_book,reports,assets,native}/**",
      "!**/node_modules/@fabric/core/.envrc",
      "!**/node_modules/@fabric/core/.hub-dev-data/**",
      "!**/node_modules/@fabric/core/settings/local.js",
      "!**/node_modules/@fabric/http/settings/local.js",
      "!**/node_modules/@hpcc-js/wasm/**",
      "!**/node_modules/blessed/**",
      "!**/node_modules/redis/**",
      "!**/node_modules/ts-morph/**",
      "!**/node_modules/@ts-morph/**",
      "!**/node_modules/node-gyp/**",
      "!**/node_modules/@webassemblyjs/**",
      "!**/node_modules/mocha/**",
      "!**/node_modules/puppeteer/**",
      "!**/node_modules/puppeteer-core/**",
      "!**/node_modules/@puppeteer/**",
      "!**/node_modules/electron/**",
      "!**/node_modules/electron-builder/**",
      "!**/node_modules/webpack/**",
      "!**/node_modules/webpack-cli/**",
      "!**/node_modules/webpack-dev-server/**",
      "!**/node_modules/jsdom/**",
      "!**/node_modules/d3/**",
      "!**/node_modules/d3-*/**",
      "!**/node_modules/@babel/**",
      "!**/node_modules/babel-loader/**",
      "!**/node_modules/semantic-ui-react/**",
      "!**/node_modules/react/**",
      "!**/node_modules/react-dom/**",
      "!**/node_modules/react-router/**",
      "!**/node_modules/react-router-dom/**",
      "!**/node_modules/jsdoc/**",
      "!**/node_modules/jsdoc-to-markdown/**",
      "!**/node_modules/caniuse-lite/**",
      "!**/node_modules/chromium-bidi/**",
      "!**/node_modules/jquery/**",
      "!**/node_modules/terser-webpack-plugin/**",
      "!**/*.map",
      "!assets/*.ldb",
      "!assets/CURRENT",
      "!assets/LOCK",
      "!assets/LOG",
      "!assets/LOG.old",
      "!assets/MANIFEST-*",
      "!assets/semantic.css",
      "!assets/semantic.rtl.css",
      "!assets/semantic.js",
      "!assets/scripts/semantic.js",
      "!assets/scripts/jquery-3.4.1.js",
      "!stores/**",
      "!binaries/**",
      "!build/.installer-binaries/**",
      "!tests/**",
      "!docs/**",
      "!coverage/**",
      "!reports/**",
      "!extension/**",
      "!libraries/**"
    ],
    "extraMetadata": {
      "main": "scripts/desktop.js"
    },
    "protocols": [
      {
        "name": "Fabric Hub",
        "schemes": [
          "fabric"
        ]
      },
      {
        "name": "Fabric Hub Bitcoin",
        "schemes": [
          "bitcoin"
        ]
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "syncDesktopName": true,
      "icon": "build/icon.png",
      "desktop": {
        "entry": {
          "Name": "Fabric Hub",
          "Comment": "Easy Bitcoin, Fabric, and Lightning node. Tray: Run at startup."
        }
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "executableName": "FabricHub",
      "artifactName": "fabrichub_${version}_${arch}.${ext}",
      "maintainer": "Fabric Labs <support@fabric.pub>"
    },
    "nsis": {
      "shortcutName": "Fabric Hub",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "deb": {
      "packageName": "fabrichub"
    }
  },
  "allowScripts": {
    "electron@39.8.10": true
  }
}
