# Copy to .env.local-mainnet (gitignored) — RPC for local mainnet bitcoind (see ~/Library/Application Support/Bitcoin/bitcoin.conf on macOS).
BITCOIN_RPC_USER=eric
BITCOIN_RPC_PASS=your-rpcpassword-here

# Optional overrides:
# FABRIC_BITCOIN_HOST=127.0.0.1
# FABRIC_BITCOIN_RPC_PORT=8332
# FABRIC_HUB_PORT=8080
# FABRIC_EXPLORER_URL=http://127.0.0.1:8080
